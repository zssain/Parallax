<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Scrub PII (SSNs, emails, ISO dates) from every log line (SPEC §9, invariant 4). -->
    <conversionRule conversionWord="mask"
                    converterClass="com.parallax.application.pii.PiiMaskingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %mask(%msg)%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
