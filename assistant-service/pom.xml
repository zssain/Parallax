<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.parallax</groupId>
        <artifactId>parallax-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>assistant-service</artifactId>
    <name>assistant-service</name>
    <description>Read-only Spring AI agent and MCP server (port 8083)</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring AI Anthropic chat starter (default provider); version from the parent spring-ai-bom. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
        <!-- Spring AI MCP server, WebMVC/SSE transport: exposes the same read-only tools over MCP
             (SPEC §12). Brings the MCP SDK (mcp-core), whose client transport the McpToolsIT reuses. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- parallax-engine: ReasonCode descriptions only (no engine invocation here). -->
        <dependency>
            <groupId>com.parallax</groupId>
            <artifactId>parallax-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- OpenAPI /v3/api-docs so the web app can generate typed clients (Prompt 20). Version
             from the parent dependencyManagement. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- The eval set (EvalRunner, JUnit tag "evals") is excluded from the default build; it
                 hits a live Anthropic-backed stack. Run it with `-Dgroups=evals` (the evals profile). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <excludedGroups>evals</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Activated by `-Dgroups=evals`: clears the default exclusion so only the eval IT runs.
             The eval IT is itself gated on ANTHROPIC_API_KEY + PARALLAX_BASE_URL, so it is skipped
             (never failed) when the stack is not up. -->
        <profile>
            <id>evals</id>
            <activation>
                <property>
                    <name>groups</name>
                    <value>evals</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <groups>evals</groups>
                            <excludedGroups combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
