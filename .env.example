# Copy to .env for `docker compose up --build`. These are DEV-ONLY defaults; every
# value here matches the built-in fallback in docker-compose.yml, so the stack also
# runs with no .env at all. Do not use these values anywhere real.

# --- Postgres ---
POSTGRES_PASSWORD=parallax-dev

# --- Database roles (owner runs Flyway, app is the least-privilege runtime role) ---
PARALLAX_OWNER_PASSWORD=owner-dev
PARALLAX_APP_PASSWORD=app-dev
ACCOUNTS_OWNER_PASSWORD=owner-dev
ACCOUNTS_APP_PASSWORD=app-dev

# --- Service-to-service token (decision-service, account-service, outbox) ---
INTERNAL_TOKEN=internal-dev

# --- PII protection (base64 32-byte keys) — DEV ONLY ---
PARALLAX_DATA_KEY=r7lS6KGA7fhaEF3Kk+cKcYYQ5KwI2h1xsEygj5d75hI=
PARALLAX_TOKEN_KEY=66yaR1D+9P3aLbna07mB/YKF0HsXxtud36b8LHwC7hM=

# --- Demo user passwords (HTTP Basic in-memory users) ---
DEMO_PASSWORD=demo-password
ASSISTANT_PASSWORD=assistant-dev

# --- AI assistant (optional). Leave blank to run the assistant in the graceful
#     "model not configured" state. Set a real key AND a valid model to enable chat. ---
ANTHROPIC_API_KEY=
PARALLAX_ASSISTANT_MODEL=claude-sonnet-5

# --- Seeding: synthetic history size (also seeds the 14 demo applications). Use
#     100000 to reproduce the README performance numbers (slower first boot). ---
SEED_COUNT=20000
